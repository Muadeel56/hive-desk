# --- Database ---
# Docker Compose maps host port 5442 -> container 5432 (host already runs a local Postgres on 5432)
DATABASE_URL="postgresql://hivedesk:hivedesk@localhost:5442/hivedesk?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# Use a long random string in real deployments, e.g. `openssl rand -base64 48`
JWT_SECRET="dev-only-change-me-to-a-long-random-string"

# --- HTTP ---
PORT=3000

# --- Socket.io ---
# Allowed CORS origin(s) for the real-time chat connection. "*" for local dev;
# in production set the widget/dashboard origin, e.g. https://app.example.com
SOCKET_CORS_ORIGIN="*"

# --- LLM provider: Google Gemini (free tier) ---
# Get a key at https://aistudio.google.com/app/apikey
LLM_API_KEY=""
LLM_API_URL="https://generativelanguage.googleapis.com/v1beta/models"
# gemini-2.0-flash is retired (404). gemini-3.6-flash is the current free-tier flash model.
LLM_MODEL="gemini-3.6-flash"
